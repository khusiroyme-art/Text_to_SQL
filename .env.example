# Required. Without it /query returns a clear error and the rest of the app
# (schema browsing, editing and running SQL) still works.
ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# Generation attempts per question: the first try plus repairs.
MAX_ATTEMPTS=3

# Flask's debugger runs arbitrary code from the browser. Local development
# only - never set this in a deployed environment.
FLASK_DEBUG=1

# Hosts inject PORT; FLASK_PORT is the local fallback.
FLASK_PORT=5000

# Only used by the Vite dev server. In production the built frontend is served
# by Flask itself, so it is same-origin and CORS does not apply.
CORS_ORIGINS=http://localhost:5173

# Uploaded databases. 25 MB default cap.
MAX_UPLOAD_BYTES=26214400
